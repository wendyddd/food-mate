[Unit]
Description=Food Mate Next.js Web
After=network.target foodmate-api.service
Wants=foodmate-api.service

[Service]
Type=simple
User=foodmate
Group=foodmate
WorkingDirectory=/opt/food-mate/food-mate-web
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
# Production build does not inject a cross-port API URL; the browser uses same-origin /api
ExecStart=/usr/bin/npm run start -- -H 127.0.0.1 -p 3000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
