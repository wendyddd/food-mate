yarn-error.log*
pnpm-debug.log*

# Vercel / Turbopack
.vercel
.turbo

# TypeScript 增量编译缓存
*.tsbuildinfo

# 测试 / Lint 缓存
coverage/
.nyc_output/
.eslintcache
.prettiercache
.stylelintcache

# 证书
*.pem

# 编辑器
.DS_Store
.idea/
.vscode/