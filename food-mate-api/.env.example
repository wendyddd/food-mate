# Food Mate API — 环境变量模板（复制为 .env 后填入真实值，切勿提交仓库）
#
#   cp .env.example .env

# ---------- LLM 厂商 ----------
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

OPENAI_API_KEY=
OPENAI_API_BASE=

DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=
DEEPSEEK_API_BASE_OPENAI=
DEEPSEEK_API_BASE_ANTHROPIC=
DEEPSEEK_MODEL_ID=

MODEL_ID=
OPENAI_MODEL_ID=

# ---------- 搜索 / 其它 ----------
TAVILY_API_KEY=
SERP_API_KEY=
SERPER_API_KEY=
OPENWEATHER_API_KEY=

# ---------- 运行时（生产由 systemd 注入亦可）----------
# 与 config.yaml general_settings.master_key 保持一致；setup 脚本会自动轮换默认值
FOODMATE_PROXY_MASTER_KEY=sk-foodmate-change-me
PROXY_PORT=4000

# 生产关闭 bash / python_repl
FOODMATE_DISABLE_DANGEROUS_TOOLS=1

# CORS（逗号分隔）；不设则用代码内默认（含 foodmates365.com）
FOODMATE_CORS_ORIGINS=https://foodmates365.com,https://www.foodmates365.com

FOODMATE_API_HOST=127.0.0.1
FOODMATE_API_PORT=8000
